# ==============================================================
# EcoRoute AI Environment Configuration
# ==============================================================
# Local Development Mode:
# Set ENVIRONMENT=development to use local SQLite and local file uploads.
# Set ENVIRONMENT=production to connect to Amazon RDS PostgreSQL and Amazon S3.

ENVIRONMENT=development
APP_NAME="EcoRoute AI"
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# --------------------------------------------------------------
# Database Settings
# --------------------------------------------------------------
# For Local Dev: uses SQLite automatically if empty or set to sqlite:///./ecoroute.db
# For AWS RDS PostgreSQL: postgresql://username:password@rds-endpoint:5432/ecoroutedb
DATABASE_URL=sqlite:///./ecoroute.db

# --------------------------------------------------------------
# Storage Settings (Local Disk vs Amazon S3)
# --------------------------------------------------------------
# STORAGE_BACKEND options: "local" or "s3"
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads

# If STORAGE_BACKEND=s3, provide AWS bucket and region:
S3_BUCKET_NAME=ecoroute-waste-photos
AWS_REGION=us-east-1
# When running on EC2 with an attached IAM Role, leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY empty.
# For local testing with real S3 (optional), configure credentials below:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --------------------------------------------------------------
# Security & Authentication (JWT)
# --------------------------------------------------------------
JWT_SECRET=super-secret-dev-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Seed Account
ADMIN_EMAIL=admin@ecoroute.local
ADMIN_PASSWORD=AdminSecurePass123!

# --------------------------------------------------------------
# Municipal Depot Location (Reference point for Route Optimization)
# --------------------------------------------------------------
DEPOT_LATITUDE=12.9716
DEPOT_LONGITUDE=77.5946
DEPOT_NAME="Central Municipal Waste Depot"
